generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Submission {
  id                    String    @id @default(uuid())
  createdAt             DateTime  @default(now())
  status                String    @default("pending")
  victimName            String
  victimAgeRange        String
  victimGender          String
  perpName              String
  perpAge               String?
  perpOccupation        String?
  perpOrganization      String?
  perpFamilyConnections String?
  crimeTypes            String[]
  incidentDate          String
  incidentLocation      String
  crimeDescription      String
  convictionStatus      String
  courtCaseNumber       String?
  verdictDate           String?
  sentenceStatus        String?
  courtDocuments        String?
  newsSources           String
  firNumber             String?
  currentLocation       String
  caseStatus            String
  appealsStatus         String?
  additionalNotes       String?
  submitterName         String?
  submitterEmail        String
  knowledgeSource       String
  willingToContact      String
  victimNameHidden      Boolean   @default(false)
  submitterAnonymous    Boolean   @default(false)
  verifiedConsent       Boolean   @default(false)
  privacyConsent        Boolean   @default(false)
  adminNotes            String?
  reviewedAt            DateTime?
  tier                  String?
  perpetrator           Perpetrator?
}

model SupportSubmission {
  id            String   @id @default(uuid())
  createdAt     DateTime @default(now())
  type          String
  status        String   @default("pending")
  email         String
  phone         String?
  district      String
  supportType   String
  orgName       String?
  regNum        String?
  contactPerson String?
  contactTitle  String?
  focusArea     String?
  howToHelp     String?
  fullName      String?
  specialty     String?
  barCouncilId  String?
  court         String?
  bmdcId        String?
  institution   String?
}

model Perpetrator {
  id               String     @id @default(uuid())
  createdAt        DateTime   @default(now())
  submissionId     String     @unique
  submission       Submission @relation(fields: [submissionId], references: [id])
  name             String
  age              String?
  occupation       String?
  organization     String?
  crimeTypes       String[]
  incidentDate     String
  location         String
  convictionStatus String
  currentStatus    String
  sentence         String?
  newsSources      String?
  tier             String?
}
